# MongoDB Atlas
MONGO_URL=mongodb+srv://<usuario>:<senha>@<cluster>/<database>?retryWrites=true&w=majority
DB_NAME=mgcar

# Gere um segredo aleatório forte e uma senha exclusiva de administrador.
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_FORTE
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=DEFINA_UMA_SENHA_FORTE_E_UNICA

# URL pública do frontend, sem barra final.
FRONTEND_URL=https://seu-site.vercel.app

# Cloudflare R2 (S3-compatible). Configure os valores reais no painel do Render.
STORAGE_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_BUCKET=cuia-car-fotos
STORAGE_ACCESS_KEY_ID=SUBSTITUA_PELA_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=SUBSTITUA_PELA_SECRET_KEY
STORAGE_REGION=auto
